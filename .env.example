DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Optional production password-recovery delivery. When either value is absent,
# requests keep account-neutral wording and use the administrator-assisted
# alpha fallback; reset URLs are never written to logs.
# RESEND_API_KEY=re_...
# SIMONE_PASSWORD_RESET_FROM=SimOne <no-reply@example.com>

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
